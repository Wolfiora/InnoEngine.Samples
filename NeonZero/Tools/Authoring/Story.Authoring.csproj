<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NovelEngineAssemblies)/Inno.*.dll" />
    <Reference Include="$(NovelScriptOutput)/Inno.VisualNovel.*.dll" />
  </ItemGroup>
  <Target Name="CheckInputs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NovelEngineAssemblies)/Inno.Scripting.Compiler.dll')" Text="Select an existing engine build with NovelEngineAssemblies." />
    <Error Condition="!Exists('$(NovelScriptOutput)/Inno.VisualNovel.Authoring.dll')" Text="Compile the plugin through the formal script API first." />
  </Target>
</Project>
