<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(EngineEditorDirectory)/Inno.*.dll" />
  </ItemGroup>
  <Target Name="CheckEditor" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(EngineEditorDirectory)/Inno.Editor.WindowsX64.dll')" Text="Select a complete existing Windows Editor build with EngineEditorDirectory." />
  </Target>
</Project>
